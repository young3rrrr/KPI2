@startuml
title Компонентна діаграма архітектури системи OpenCRM (UML Component Diagram)

top to bottom direction
skinparam componentStyle uml2
skinparam packageStyle rectangle
skinparam defaultFontSize 12
skinparam ArrowFontSize 11
skinparam nodesep 65
skinparam ranksep 50

rectangle "Межа системи OpenCRM (OpenCRM System Boundary — Docker ≤ 512 МБ RAM за NFR-05)" as SystemBoundary {

  package "1. Клієнтський веб-інтерфейс (Web UI — React / Ant Design)" as UILayer {
    component "Web UI (SPA)\n[React / Ant Design]\n---\n• Воронка угод (Kanban: UC-01, UC-05, UC-06)\n• Картки лідів і клієнтів (UC-02)\n• Каталог товарів (UC-03 — Admin)\n• Список активностей (UC-04)\n(Ролі: SalesManager, Admin)" as WebUI
  }

  interface "REST API (HTTPS / TLS 1.3)" as IRestAPI

  package "2. Вхідний шар API (API Gateway & Controllers — Fastify)" as APILayer {
    component "Auth & RateLimit Middleware\n[Fastify Hook]\n---\n• Перевірка JWT (15 хв / 7 днів)\n• Контроль ролей RBAC: SalesManager / Admin (NFR-04)\n• Rate Limiting: > 80 RPS → HTTP 429 (NFR-02)" as AuthMiddleware

    component "LeadClientController\n[Fastify]\n---\nРобота з лідами\nта клієнтами (UC-02)" as LeadClientController
    component "CatalogController\n[Fastify]\n---\nКерування товарами\nдля Admin (UC-03)" as CatalogController
    component "ActivityController\n[Fastify]\n---\nЗадачі менеджера\n(UC-04)" as ActivityController
    component "DealController\n[Fastify]\n---\nМаршрути угод і знижок\n(UC-01, UC-05, UC-06)" as DealController
  }

  package "3. Сервісний шар бізнес-логіки (Business Services)" as ServiceLayer {
    interface "ILeadClientService" as ILeadClientService
    interface "ICatalogService" as ICatalogService
    interface "IActivityService" as IActivityService
    interface "IDealService" as IDealService
    interface "IPricingService" as IPricingService
    interface "IEmailService" as IEmailService

    component "LeadClientService\n---\nКваліфікація та конвертація\nліда в клієнта 1:1 (UC-02)" as LeadClientService
    component "CatalogService\n---\nКерування каталогом товарів:\nbase_price та is_active (UC-03)" as CatalogService
    component "ActivityService\n---\nСтворення та контроль\nвиконання завдань (UC-04)" as ActivityService
    component "DealService\n---\nУправління життєвим циклом угоди,\nперевірка статусів та координація\n(UC-01, UC-05, UC-06)" as DealService
    component "PricingService\n<<Pure Domain Service>>\n---\nІзольований розрахунок вартості\nDealItem та пропорційний перерахунок\nзнижки (UC-06) без доступу до БД" as PricingService
    component "EmailService\n---\nВнутрішній модуль формування\nсповіщень про договори" as EmailService
  }

  package "4. Шар доступу до даних (Data Access Layer — Drizzle ORM)" as DALLayer {
    interface "IClientLeadRepository" as IClientLeadRepo
    interface "IProductRepository" as IProductRepo
    interface "IActivityUserRepository" as IActivityUserRepo
    interface "IDealRepository" as IDealRepo

    component "ClientLeadRepository\n[Drizzle ORM]\n---\nТаблиці: Lead, Client" as ClientLeadRepository
    component "ProductRepository\n[Drizzle ORM]\n---\nТаблиця: Product" as ProductRepository
    component "ActivityUserRepository\n[Drizzle ORM]\n---\nТаблиці: Activity, User" as ActivityUserRepository
    component "DealRepository\n[Drizzle ORM]\n---\nТаблиці: Deal, DealItem" as DealRepository
  }

  package "5. База даних (PostgreSQL 16+)" as DBLayer {
    interface "SQL / Drizzle ORM" as ISQL
    database "PostgreSQL 16+\n---\nРеляційне сховище даних (7 сутностей Лаб 1):\nUser, Lead, Client, Deal, DealItem, Product, Activity" as PostgresDB
  }
}

interface "ISMTP (SMTP / TLS)" as ISMTP
component "Зовнішній поштовий шлюз\n(External SMTP Gateway)\n<<External System>>" as ExternalSMTP

' Вирівнювання порядку компонентів у шарах для відсутності перетинів
LeadClientController -[hidden]right- CatalogController
CatalogController -[hidden]right- ActivityController
ActivityController -[hidden]right- DealController

ILeadClientService -[hidden]right- ICatalogService
ICatalogService -[hidden]right- IActivityService
IActivityService -[hidden]right- IDealService
IDealService -[hidden]right- IPricingService
IPricingService -[hidden]right- IEmailService

LeadClientService -[hidden]right- CatalogService
CatalogService -[hidden]right- ActivityService
ActivityService -[hidden]right- DealService
DealService -[hidden]right- PricingService
PricingService -[hidden]right- EmailService

IClientLeadRepo -[hidden]right- IProductRepo
IProductRepo -[hidden]right- IActivityUserRepo
IActivityUserRepo -[hidden]right- IDealRepo

ClientLeadRepository -[hidden]right- ProductRepository
ProductRepository -[hidden]right- ActivityUserRepository
ActivityUserRepository -[hidden]right- DealRepository

' 1. Взаємодія клієнта та вхідного шару API через Auth & RateLimit Middleware
WebUI --( IRestAPI : HTTPS (TLS 1.3)
IRestAPI -- AuthMiddleware

AuthMiddleware --> LeadClientController : JWT + RBAC\n(SalesManager)
AuthMiddleware --> CatalogController : JWT + RBAC\n(Admin only)
AuthMiddleware --> ActivityController : JWT + RBAC\n(SalesManager)
AuthMiddleware --> DealController : JWT + RBAC\n(SalesManager)

' 2. Provided інтерфейси сервісів бізнес-логіки
ILeadClientService -- LeadClientService
ICatalogService -- CatalogService
IActivityService -- ActivityService
IDealService -- DealService
IPricingService -- PricingService
IEmailService -- EmailService

' Сувора шарова ізоляція між контролерами та сервісами (Required інтерфейси)
LeadClientController --( ILeadClientService : convertLead()
CatalogController --( ICatalogService : updateProduct()\ntoggleActive()
ActivityController --( IActivityService : scheduleActivity()
DealController --( IDealService : confirmDealContract()\napplyDiscount()

' 3. Координація всередині сервісного шару (відповідно до Лаб 3 та Лаб 4)
DealService -up-( IActivityService : контрольна задача\n(type='call')
DealService -up-( IPricingService : calculateTotal()\napplyDiscountToItems()
DealService -up-( IEmailService : sendContractNotification()\n<<async>>

' 4. Provided інтерфейси репозиторіїв Data Access Layer
IClientLeadRepo -- ClientLeadRepository
IProductRepo -- ProductRepository
IActivityUserRepo -- ActivityUserRepository
IDealRepo -- DealRepository

' Взаємодія сервісів володіння даними з репозиторіями (PricingService ізольований від БД)
LeadClientService --( IClientLeadRepo : CRUD Lead, Client
CatalogService --( IProductRepo : CRUD Product\n(base_price, is_active)
ActivityService --( IActivityUserRepo : CRUD Activity, User
DealService --( IProductRepo : перевірка Product.is_active
DealService --( IDealRepo : CRUD Deal, DealItem

' 5. Взаємодія репозиторіїв із БД PostgreSQL 16+
ISQL -- PostgresDB
ClientLeadRepository --( ISQL
ProductRepository --( ISQL
ActivityUserRepository --( ISQL
DealRepository --( ISQL

' 6. Зовнішня інтеграція з External SMTP Gateway
ISMTP -- ExternalSMTP
EmailService --( ISMTP : відправка листів\nіз договорами

@enduml
