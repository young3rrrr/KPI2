sequenceDiagram
    autonumber
    actor SalesManager as Менеджер з продажу (SalesManager)
    participant DealController as Контролер угод (DealController)
    participant DealService as Сервіс угод (DealService)
    participant ProductRepository as Репозиторій товарів (ProductRepository)
    participant DealRepository as Репозиторій угод (DealRepository)

    SalesManager->>DealController: POST /deals/{deal_id}/confirm (status='new', items: DealItem[])
    activate DealController

    DealController->>DealService: confirmDealContract(deal_id, items)
    activate DealService

    break Список товарних позицій порожній (items.isEmpty() == true)
        Note over DealService,DealRepository: Запис у DealRepository не відбувається, Deal залишається в status='new'
        DealService-->>DealController: return EmptyDealItemsError("Угода не містить жодної позиції DealItem")
        DealController-->>SalesManager: return 400 Bad Request (EmptyDealItemsError: "Угода не може перейти в статус contract без товарів")
    end

    loop Для кожної позиції item (product_id, quantity) зі списку items
        DealService->>ProductRepository: findById(product_id)
        activate ProductRepository
        ProductRepository-->>DealService: return Product(id=product_id, base_price, is_active=false)
        deactivate ProductRepository

        break Товар неактивний (Product.is_active == false)
            Note over DealService,DealRepository: Product.is_active == false — збереження DealItem(deal_id, product_id, quantity, actual_price)<br/>та оновлення Deal(status='new', total_amount) у DealRepository скасовано
            DealService-->>DealController: return InactiveProductError("Товар product_id є неактивним: Product.is_active = false")
            DealController-->>SalesManager: return 400 Bad Request (InactiveProductError: "Неможливо додати неактивний товар до угоди")
        end
    end

    deactivate DealService
    deactivate DealController
